<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="姓名：袁浩翔  学号：2406100227" />

    <TextView
        android:id="@+id/tv_receive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF0000"
        android:layout_marginTop="10dp"
        android:text="收到姓名：" />

    <!--RadioGroup-->
    <RadioGroup
        android:id="@+id/rg_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">
        <RadioButton android:id="@+id/rb_good" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="信用良好" android:checked="true"/>
        <RadioButton android:id="@+id/rb_bad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="有逾期" />
    </RadioGroup>

    <!--Spinner-->
    <Spinner
        android:id="@+id/spinner_job"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp" />

    <!--CheckBox -->
    <CheckBox
        android:id="@+id/cb_house"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="名下有房产" />

    <!--ImageButton -->
    <ImageButton
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:src="@android:drawable/ic_menu_save"
        android:contentDescription="保存" />
</LinearLayout>